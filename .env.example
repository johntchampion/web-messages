# Everything here is optional; docker-compose.yml has working defaults.

# Host ports
SERVICE_PORT=8000
PWA_PORT=3000

# Application
APP_NAME=OneTimeChat
TOKEN_SECRET=local-development-secret

# Feature flags
VERIFY_USERS=false
SEND_EMAILS=false
ENABLE_UPLOADS=false

# "test" logs verification and password-reset codes to the service logs instead of emailing them
NODE_ENV=test

# Email via Mailjet (only needed if SEND_EMAILS=true)
MAILJET_API_KEY=
MAILJET_API_SECRET=

# Web Push (enabled when all three are set; generate keys with `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# AI responses (enabled when set; an Ollama server running on your machine)
# OLLAMA_HOST=http://host.docker.internal:11434
